# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 6.0.3 Project Minimal Configuration
#
# default:
CONFIG_IDF_TARGET="esp32s3"
# The messages (~5 kB/s of JSON) go out on the native USB port: console there only.
# (UART at 115200 baud carries only ~11.5 kB/s, too close to the output with diagnostics.)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
