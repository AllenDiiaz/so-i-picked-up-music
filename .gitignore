# ESP-IDF build output (binaries, .elf, .bin, CMake cache)
build/

# Generated full config; sdkconfig.defaults is tracked instead
sdkconfig
sdkconfig.old

# Components downloaded by the IDF Component Manager
managed_components/

# Editor / language-server caches (clangd)
.cache/
.vscode/
compile_commands.json
# Local clangd settings: contain machine-specific toolchain paths
.clangd

# OS and logs
.DS_Store
*.log

# Python virtual environment for analysis/ and bytecode caches
.venv/
__pycache__/

# Bridge session logs (bridge/bridge.py): personal data, kept local
sessions/

# Real Wi-Fi credentials for 08_wifi_stream (only the .example is tracked)
firmware/experiments/08_wifi_stream/main/wifi_config.h

# Local Claude Code permissions (machine-specific)
.claude/settings.local.json

# README video: licensed / personal source material (BioRender figure, practice videos), never committed
media/readme_video/private/
